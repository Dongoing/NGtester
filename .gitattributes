# 强制所有文本文件在检出时用 LF 行尾。5g-lab 的脚本要在 bash / WSL / Git Bash 里跑，
# 若 clone 到 Windows 后变成 CRLF，会报 `bad interpreter: /bin/bash^M`。这里统一 LF 根治。
* text=auto eol=lf

*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.env  text eol=lf
*.conf text eol=lf
*.sql  text eol=lf
*.json text eol=lf

# 二进制文件不做行尾转换
*.exe  binary
*.zip  binary
*.pem  binary
*.key  binary
*.png  binary
*.jpg  binary
*.pcap binary
