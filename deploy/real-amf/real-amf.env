# ==============================================================================
# 连“真实华为 AMF”用的参数。现场填好本文件后，用 run-gnb.sh / run-ue.sh 自动渲染
# 出 UERANSIM 的 gnb.yaml / ue.yaml 并启动（合法 gNB + 合法 UE，造一个已注册的受害者）。
#
# 必须在【镜像网络(mirrored)的 WSL2 Ubuntu】里跑：NGAP 走 SCTP，Docker Desktop /
# WinNAT 送不出 SCTP 到外部 AMF。先按 ../wslconfig-mirrored.txt 把
# %USERPROFILE%\.wslconfig 设成 networkingMode=mirrored，再 `wsl --shutdown`。
# 环境安装见 ../bootstrap.sh。
# ==============================================================================

# ---- 真实华为 AMF 的 N2(NGAP/SCTP)端点 ----
AMF_ADDR=14.55.2.5
AMF_PORT=38412

# ---- 本机(镜像 WSL 主机)朝 AMF 那张网卡的 IP；这也是华为 AMF 看到的 gNB 源 IP，
#      要提前报给华为做白名单。留空=脚本用 `ip route get` 自动探测 ----
HOST_IP=

# ==============================================================================
# 下面这些【必须和华为核心网一致】，否则 NG Setup 或注册会被拒。
# 默认是 5g-lab 测试值(PLMN 001/01)。若华为用真实 PLMN：改 MCC/MNC + IMSI 前缀，
# 并把 TAC / 切片 / DNN 都换成华为允许的值。
# ==============================================================================
MCC=001
MNC=01
TAC=1
SLICE_SST=1
SLICE_SD=0x010203
DNN=internet

# ---- 合法基站 gNB 身份：必须和 ngap_tester(config/huawei.json 里 gnb_id=4660=0x1234)
#      【不同】，且被华为允许。NCI 是 36-bit，高 GNB_ID_LEN 位是 gNB-ID。
#      0x000000010 => gNB-ID=1(与 4660 不同) ----
NCI=0x000000010
GNB_ID_LEN=32

# ==============================================================================
# 测试 UE 凭据 —— 这组必须已被华为核心网 UDM/AUSF【开户】(IMSI/K/OPc/AMF/SQN)，
# 否则 5G-AKA 双向认证失败、UE 注册不上、后续攻击也就没有受害 UE。
# ==============================================================================
UE1_IMSI=001010000000001
UE1_KI=8baf473f2f8fd09487cccbd7097c6862
UE1_OPC=8e27b6af0e692e750f32667a3b14605d
UE1_OP_TYPE=OPC
UE1_AMF=8000
UE1_IMEI=356938035643803
UE1_IMEISV=4370816125816151

# ---- UERANSIM 源码/构建目录(bootstrap.sh 会 git clone + make 到这里)。留空=$HOME/UERANSIM ----
UERANSIM_DIR=
