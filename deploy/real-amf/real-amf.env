# ==============================================================================
# 华为现场参数（合法 UERANSIM gNB + UE）。改完后 run-gnb.sh / run-ue.sh 会重新渲染 yaml。
# 在测试机 Ubuntu 上原生跑（不要走 Docker）。操作步骤见 ../操作手册_华为AMF.md
# ==============================================================================

# ---- 华为 AMF N2 ----
AMF_ADDR=14.66.2.5
AMF_PORT=38412

# ---- 本机朝 AMF 的源 IP（UERANSIM ngapIp/gtpIp/linkIp；华为侧 gNB 白名单）----
HOST_IP=13.254.241.142

# ---- 网络标识（必须与华为核心网一致）----
MCC=460
MNC=08
TAC=1
SLICE_SST=1
SLICE_SD=0x010101
DNN=huawei.com
# 华为若给了 DNN 内可达地址（测数据面），填这里；留空则 check-up.sh 只 ping 隧道网关
PING_TARGET=

# ---- 合法 gNB：gNB-ID=1。流氓 ngap_tester 用 gnb_id=4660，两者必须不同 ----
NCI=0x000000010
GNB_ID_LEN=32

# ---- 已在华为核心网开户的测试 UE ----
UE1_IMSI=460081111111113
UE1_KI=1234567890abcde1234567890abcde12
UE1_OPC=FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
UE1_OP_TYPE=OPC
UE1_AMF=8000
UE1_IMEI=356938035643803
UE1_IMEISV=4370816125816151

# 留空 = $HOME/UERANSIM
UERANSIM_DIR=
