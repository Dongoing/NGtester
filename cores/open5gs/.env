# ============================================================
# 5g-lab / Open5GS 核心网 —— 网络与网元 IP 规划
# 子网: 172.30.10.0/24   网络名: net-open5gs   AMF N2: 172.30.10.10
# ============================================================

MCC=001
MNC=01
TAC=1

NETWORK_NAME=Open5GS
EPC_DOMAIN=epc.mnc001.mcc001.3gppnetwork.org

TEST_NETWORK=172.30.10.0/24
TEST_NETWORK_DYN=172.30.10.192/26
DOCKER_HOST_IP=127.0.0.1

# ---- 5G SA 网元 ----
MONGO_IP=172.30.10.2
WEBUI_IP=172.30.10.3
NRF_IP=172.30.10.4
SCP_IP=172.30.10.5
AUSF_IP=172.30.10.6
UDR_IP=172.30.10.7
UDM_IP=172.30.10.8
SMF_IP=172.30.10.9
AMF_IP=172.30.0.10
UPF_IP=172.30.10.11
UPF_ADVERTISE_IP=172.30.10.11
PCF_IP=172.30.10.12
BSF_IP=172.30.10.13
NSSF_IP=172.30.10.14

# ---- UPF 隧道接口 ----
UPF_TUNTAP_MODE=tun
UPF_INTERNET_APN_IF_NAME=ogstun
UPF_IMS_APN_IF_NAME=ogstun2

# ---- SMF DNS ----
SMF_DNS1=8.8.8.8
SMF_DNS2=8.8.4.4

# ---- UE 地址池（每套核心网用不同池便于区分）----
UE_IPV4_INTERNET=10.51.0.0/24
UE_IPV4_IMS=10.51.1.0/24
MAX_NUM_UE=1024

# ---- 以下网元本套部署不启用（IMS/4G/计费），但配置模板会引用这些变量，
#      指向保留地址即可，不影响 5G SA 功能 ----
PCSCF_IP=172.30.10.240
PCRF_IP=172.30.10.241
PCRF_BIND_PORT=3873
OCS_IP=172.30.10.242
OCS_BIND_PORT=3872
OSMOEPDG_IP=172.30.10.243
