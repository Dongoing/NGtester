# 基站挂接 oai 核心网 —— 统一 profile（一次只跑一套核心网）
CORE_NAME=oai
CORE_NETWORK=net-5glab
CORE_AMF_ADDR=172.30.0.10

# ==== 统一网络标识（四套一致）====
MCC=001
MNC=01
TAC=1
SLICE_SST=1
SLICE_SD=0x010203
APN=internet

# ==== 统一测试 UE（四套一致，OPc 型）====
UE1_IMSI=001010000000001
UE1_KI=8baf473f2f8fd09487cccbd7097c6862
UE1_OP=8e27b6af0e692e750f32667a3b14605d
UE1_OP_TYPE=OPC
UE1_OPC=8e27b6af0e692e750f32667a3b14605d
UE1_AMF=8000

# ==== srsRAN 基站固定 IP（ZMQ 模式）====
SRS_GNB_IP=172.30.0.180
SRS_UE_IP=172.30.0.181
SRS_UE_COMPONENT=ue_5g_zmq2
