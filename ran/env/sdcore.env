# 基站挂接 SD-Core 核心网（跑在 kind 集群，网络与 IP 与其余三套不同）
CORE_NAME=sdcore
CORE_NETWORK=kind
CORE_AMF_ADDR=10.244.0.16

# ==== 统一网络标识（与其余三套一致）====
MCC=001
MNC=01
TAC=1
SLICE_SST=1
SLICE_SD=0x010203
APN=internet

# gNB 到 UPF N3 (access 网段) + AMF pod 的路由，经 kind 节点转发
EXTRA_ROUTES=10.244.0.0/16:172.20.0.2,192.168.252.0/24:172.20.0.2

# ==== 统一测试 UE（与其余三套一致，OPc 型）====
UE1_IMSI=001010000000001
UE1_KI=8baf473f2f8fd09487cccbd7097c6862
UE1_OP=8e27b6af0e692e750f32667a3b14605d
UE1_OP_TYPE=OPC
UE1_OPC=8e27b6af0e692e750f32667a3b14605d
UE1_AMF=8000
